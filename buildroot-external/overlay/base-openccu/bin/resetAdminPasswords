#!/bin/sh
# shellcheck shell=dash disable=SC2169,SC3010 source=/dev/null
#
# resetAdminPasswords
#
# Clears the passwords of all WebUI (ReGaHss) users with administrator rights
# and the password of the OS 'root' user (local console/SSH) so that a system
# with forgotten passwords becomes accessible again without having to perform
# a factory reset. All other configuration data stays untouched.
#
# Afterwards the WebUI asks for a new administrator password on the next
# login (like after the initial installation) and a new SSH password can be
# set in the WebUI control panel ("Security" -> "SSH").
#
# This script is either executed manually (e.g. on the local console or via
# 'docker exec') or automatically by /etc/init.d/S70ReGaHss after ReGaHss
# was started if /usr/local/.doAdminPasswordReset had been created by the
# "Reset Admin Passwords" action of the recovery system.
#
# Usage: resetAdminPasswords [-w <seconds>]
#
#  -w <seconds>  time to wait for ReGaHss to become ready (default: 30)
#

SHADOW_FILE=/etc/config/shadow
USERPROFILES_DIR=/etc/config/userprofiles
SECURITY_HINT_FILE=/etc/config/userAckSecurityHint
WAIT_SECONDS=30

usage() {
  echo "Usage: $0 [-w <seconds>]"
  echo "Clears the passwords of all WebUI administrators and of the OS root user."
  echo "  -w <seconds>  time to wait for ReGaHss to become ready (default: ${WAIT_SECONDS})"
}

while getopts "w:h" opt; do
  case "${opt}" in
    w)
      WAIT_SECONDS="${OPTARG}"
    ;;
    h)
      usage
      exit 0
    ;;
    *)
      usage
      exit 1
    ;;
  esac
done

if ! echo "${WAIT_SECONDS}" | grep -qE '^[0-9]+$'; then
  echo "ERROR: invalid wait time '${WAIT_SECONDS}'"
  usage
  exit 1
fi

if [[ "$(id -u)" != "0" ]]; then
  echo "ERROR: $0 has to be executed as root"
  exit 1
fi

# clear the password of the OS root user (a new one can be set via the WebUI)
reset_os_password() {
  echo -n "Clearing OS root password... "

  if [[ ! -f "${SHADOW_FILE}" ]] || ! grep -q "^root:" "${SHADOW_FILE}"; then
    echo "ERROR (no root user in ${SHADOW_FILE})"
    return 1
  fi

  if ! sed -i 's/^root:[^:]*:/root::/' "${SHADOW_FILE}"; then
    echo "ERROR (sed)"
    return 1
  fi
  chmod 0640 "${SHADOW_FILE}"
  chown root:root "${SHADOW_FILE}"

  echo "done."
  return 0
}

# clear the passwords of all WebUI users with administrator rights via ReGaHss
# and make sure the WebUI asks for a new password on the next login
reset_webui_passwords() {
  echo "Clearing WebUI administrator passwords:"

  # source all data from /var/hm_mode
  [[ -r /var/hm_mode ]] && . /var/hm_mode
  if [[ -n "${HM_MODE}" ]] && [[ "${HM_MODE}" != "NORMAL" ]]; then
    echo "ERROR: ReGaHss is not used in ${HM_MODE} mode"
    return 1
  fi

  WAIT_SECONDS="${WAIT_SECONDS}" USERPROFILES_DIR="${USERPROFILES_DIR}" \
  SECURITY_HINT_FILE="${SECURITY_HINT_FILE}" tclsh <<'EOF'
load tclrega.so

set waitSeconds $env(WAIT_SECONDS)
set userProfilesDir $env(USERPROFILES_DIR)
set securityHintFile $env(SECURITY_HINT_FILE)

# wait until ReGaHss is ready to process scripts
set deadline [expr {[clock seconds] + $waitSeconds}]
while {1} {
  if {![catch {array set ready [rega_script {Write("READY");}]}] &&
      [info exists ready(STDOUT)] && $ready(STDOUT) eq "READY"} {
    break
  }
  if {[clock seconds] >= $deadline} {
    puts "ERROR: ReGaHss is not running or not ready"
    exit 1
  }
  after 2000
}

# clear the passwords of all admin users and save the object model
if {[catch {array set result [rega_script {
  string sUserId;
  foreach(sUserId, dom.GetObject(ID_USERS).EnumUsedIDs()) {
    object oUser = dom.GetObject(sUserId);
    if (oUser) {
      if (oUser.UserLevel() == iulAdmin) {
        oUser.UserBlankPwd("");
        WriteLine(oUser.Name());
      }
    }
  }
  system.Save();
}]} err]} {
  puts "ERROR: ReGaHss script failed: $err"
  exit 1
}

set users {}
if {[info exists result(STDOUT)]} {
  foreach name [split $result(STDOUT) "\n"] {
    if {$name ne ""} {
      lappend users $name
    }
  }
}

if {[llength $users] == 0} {
  puts "ERROR: no WebUI user with administrator rights found"
  exit 1
}

foreach name $users {
  puts "  - $name"
  # let the WebUI show the install wizard (incl. password dialog) again
  catch {file delete -- [file join $userProfilesDir "userAckInstallWizard_[string map {{ } ;} $name]"]}
}

# let the WebUI show the initial security note (incl. no password warning)
catch {file delete -- $securityHintFile}

puts "done."
exit 0
EOF
}

RC=0
reset_os_password || RC=1
reset_webui_passwords || RC=1

if [[ ${RC} -eq 0 ]]; then
  echo "All administrator passwords cleared. Please set new passwords via the WebUI immediately."
else
  echo "ERROR: not all administrator passwords could be cleared."
fi

exit ${RC}
