#!/bin/sh
# shellcheck shell=dash disable=SC2169,SC3010
#
# Startup script to check for a reset of all administrator passwords
# (WebUI + OS root user) requested via the recovery system
#

FLAG_FILE=/usr/local/.doAdminPasswordReset

start() {
  echo -n "Checking for Admin Password Reset: "

  # only continue if .doAdminPasswordReset file exists
  if [[ ! -e "${FLAG_FILE}" ]]; then
    echo "not required"
    return 0
  fi

  # remove the flag file first so that the reset is only performed
  # once, even if it fails or the system is rebooted in between
  rm -f "${FLAG_FILE}"
  sync

  # ReGaHss might still be loading its object model, thus run the
  # reset in the background and wait for ReGaHss to become ready
  (/bin/resetAdminPasswords -w 300 2>&1 | logger -t resetAdminPasswords -p user.warn) </dev/null >/dev/null 2>&1 &

  echo "started (see syslog)"
}

restart() {
  start
}

case "$1" in
  start)
    start
  ;;
  stop)
    # nothing
  ;;
  restart|reload)
    restart
  ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
