#!/bin/sh
# shellcheck shell=dash disable=SC2169,SC3010 source=/dev/null
#
# Starts ReGaHss.
#

CREATE_DIRS='/usr/local/etc/config/rc.d /usr/local/etc/config/addons/www'

LOGLEVEL_REGA=2
REGA_BIN_VERSION=
DAEMON="ReGaHss"
PIDFILE="/var/run/${DAEMON}.pid"
ADMIN_PASSWORD_RESET_FLAG=/usr/local/.doAdminPasswordReset

[[ -r /var/hm_mode ]] && . /var/hm_mode

# skip this startup if not in normal mode
[[ "${HM_MODE}" != "NORMAL" ]] && exit 0

# 'DEBUG' in /etc/config/ReGaHssVersion starts ReGaHss in debug mode
if [[ -s /etc/config/ReGaHssVersion ]]; then
	REGA_BIN_VERSION=$(cat /etc/config/ReGaHssVersion)
fi

init() {
	for i in ${CREATE_DIRS}; do
		[[ ! -d ${i} ]] && mkdir -p "${i}"
	done

	if [[ ! -d /etc/config/userprofiles ]]; then
		mkdir -p /etc/config/userprofiles
	fi

	if [[ -f /etc/config/syslog ]]; then
		. /etc/config/syslog
	fi

	# source profile.d files
	if [[ ! -e /etc/config/safemode ]] ; then
		# source from /etc/profile.d
		for i in /etc/profile.d/*.sh ; do
			if [[ -r "$i" ]]; then
				. "$i"
			fi
			unset i
		done

		# source from /usr/local/etc/profile.d
		if [[ -d /usr/local/etc/profile.d ]]; then
			for i in /usr/local/etc/profile.d/*.sh ; do
				if [[ -r "$i" ]]; then
					. "$i"
				fi
				unset i
			done
		fi
	fi
}

waitStartupComplete() {
	STEPS=20
	for i in $(seq 1 ${STEPS}); do
		sleep 2
		echo -n "."
		if [[ -n "$(pidof ${DAEMON})" ]]; then
			echo "OK"
			break
		fi
		if [[ ${i} -eq ${STEPS} ]]; then
			echo "ERROR"
		fi
	done
}

waitTerminationComplete() {
	STEPS=20
	for i in $(seq 1 ${STEPS}); do
		sleep 2
		echo -n "."
		if [[ -z "$(pidof ${DAEMON})" ]]; then
			echo "OK"
			break
		fi
		if [[ ${i} -eq ${STEPS} ]]; then
			echo "ERROR"
		fi
	done
}

checkAdminPasswordReset() {
	[[ -e ${ADMIN_PASSWORD_RESET_FLAG} ]] || return 0

	# remove the flag file first so that the reset is only performed
	# once, even if it fails or the system is rebooted in between
	rm -f ${ADMIN_PASSWORD_RESET_FLAG}
	sync

	# ReGaHss might still be loading its object model, thus run the
	# reset in the background and let it wait for ReGaHss to become ready
	(/bin/resetAdminPasswords -w 300 2>&1 | logger -t resetAdminPasswords -p user.warn) </dev/null >/dev/null 2>&1 &
	echo "Admin password reset started (see syslog)"
}

start() {
	echo -n "Starting ReGaHss: "
	init

	# make sure ReGaHss will run on umask 0027 per default so
	# that files/dirs will not be generated world readable per default
	umask 0027

	# adjust the oom score (which is inherited by start-stop-daemon)
	# to ensure that others are killed first in case of low memory situations
	echo -900 >/proc/$$/oom_score_adj 2>/dev/null

	# start ReGaHss (normal or in debug mode)
	if [[ "${REGA_BIN_VERSION}" == "DEBUG" ]]; then
		start-stop-daemon -d / -S -q -b -m -p ${PIDFILE} --exec /usr/bin/script -- -q -c "/bin/${DAEMON} -f /etc/rega.conf -l 0 -c 2>&1" /usr/local/tmp/${DAEMON}-$$.log
		echo -n "DEBUG (/usr/local/tmp/${DAEMON}-$$.log), "
	else
		start-stop-daemon -d / -S -q -b -m -p ${PIDFILE} --exec /bin/${DAEMON} -- -f /etc/rega.conf -l ${LOGLEVEL_REGA}
	fi

	# wait until ReGaHss is started.
	waitStartupComplete

	# make sure the PID file has world readable permissions
	chmod 0644 ${PIDFILE}

	# check if a reset of all admin passwords (WebUI + OS) was requested
	# (e.g. via the recovery system) and perform it once ReGaHss is ready
	checkAdminPasswordReset
}

stop() {
	echo -n "Stopping ReGaHss: "

	if [[ -f ${PIDFILE} ]]; then

		# as ReGaHss is not saving its config upon termination we force a final
		# config save now
		echo -n "."
		echo "load tclrega.so; rega system.Save()" | /bin/tclsh 2>/dev/null
		sync

		# signal ReGaHss to stop
		start-stop-daemon -K -q -p ${PIDFILE}

		# wait for ReGaHss to terminate
		waitTerminationComplete
		rm -f ${PIDFILE}
	else
		echo "OK"
	fi
}

restart() {
	stop
	start
}

case "$1" in
	start)
		start
	;;
	stop)
		stop
	;;
	restart|reload)
		restart
	;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit 0
