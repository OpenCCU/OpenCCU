   }
 
   // set LEDs of a RPI-RF-MOD
-  if(rpiRfModFound == true &&
-     ((newStateRed != oldStateRed || newStateGreen != oldStateGreen || newStateBlue != oldStateBlue) &&
-      (newStateRed != led::UNKNOWN && newStateGreen != led::UNKNOWN && newStateBlue != led::UNKNOWN)))
