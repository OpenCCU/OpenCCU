diff --git a/src/hss_led/LedProtocol.h b/src/hss_led/LedProtocol.h
new file mode 100644
index 0000000..34fe74f
--- /dev/null
+++ b/src/hss_led/LedProtocol.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef OPENCCU_LED_PROTOCOL_H
+#define OPENCCU_LED_PROTOCOL_H
+#include <cerrno>
+#include <cstring>
+#include <poll.h>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace LedProtocol {
+static const char socketPath[] = "/run/rpi-rf-mod-led/control";
+// One request and one acknowledgement per connection. Bounded waits keep a
+// missing or wedged daemon from blocking hss_led's status checks indefinitely.
+inline bool request(const std::string& path, const std::string& message,
+                    std::string& reply, int timeout = 500) {
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (path.size() >= sizeof(address.sun_path)) return false;
+  std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+  int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+  if (fd < 0) return false;
+  bool ok = false;
+  if (connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0 &&
+      send(fd, message.data(), message.size(), MSG_NOSIGNAL) == static_cast<ssize_t>(message.size())) {
+    pollfd event = {fd, POLLIN, 0};
+    int ready = poll(&event, 1, timeout);
+    if (ready > 0 && (event.revents & POLLIN)) {
+      char buffer[1024];
+      ssize_t n = recv(fd, buffer, sizeof(buffer), MSG_TRUNC);
+      if (n > 0 && n < static_cast<ssize_t>(sizeof(buffer))) {
+        reply.assign(buffer, static_cast<size_t>(n));
+        ok = reply.compare(0, 2, "OK") == 0;
+      }
+    }
+  }
+  close(fd);
+  return ok;
+}
+}
+#endif
diff --git a/src/hss_led/RgbLed.cpp b/src/hss_led/RgbLed.cpp
new file mode 100644
index 0000000..1e8d8c9
--- /dev/null
+++ b/src/hss_led/RgbLed.cpp
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "RgbLed.h"
+#include <cstdio>
+
+void RgbLed::set(unsigned first, unsigned second, unsigned periodMs) {
+  if (first > 7 || second > 7 || periodMs > 86400000) return;
+  if (!periodMs) second = first;
+  const std::string command = "1 report " + std::to_string(first) + " " +
+      std::to_string(second) + " " + std::to_string(periodMs) + " " + std::to_string(periodMs);
+  std::string reply;
+  // Repeat even unchanged reports: a replacement service always receives the
+  // latest status. Its pattern comparison keeps an existing phase clock intact.
+  if (!LedProtocol::request(socketPath, command, reply)) {
+    const std::time_t now = std::time(nullptr);
+    if (!lastError || now - lastError >= 30) {
+      std::fprintf(stderr, "hss_led: LED service unavailable or rejected status: %s\n", reply.c_str());
+      lastError = now;
+    }
+  }
+}
diff --git a/src/hss_led/RgbLed.h b/src/hss_led/RgbLed.h
new file mode 100644
index 0000000..03c4fa8
--- /dev/null
+++ b/src/hss_led/RgbLed.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef HSS_RGB_LED_H
+#define HSS_RGB_LED_H
+#include <string>
+#include <ctime>
+#include "LedProtocol.h"
+
+// hss_led determines status; the LED service alone owns sysfs and its timers.
+// Never fall back to direct writes when the daemon is restarting/unavailable.
+class RgbLed {
+public:
+  explicit RgbLed(const std::string& socket = LedProtocol::socketPath) :
+      socketPath(socket), lastError(0) {}
+  void set(unsigned first, unsigned second, unsigned periodMs);
+private:
+  std::string socketPath;
+  std::time_t lastError;
+};
+#endif
diff --git a/src/hss_led/tests/RgbLedTest.cpp b/src/hss_led/tests/RgbLedTest.cpp
new file mode 100644
index 0000000..4d202ca
--- /dev/null
+++ b/src/hss_led/tests/RgbLedTest.cpp
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "RgbLed.h"
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+static void require(bool ok) { if (!ok) throw std::runtime_error("LED protocol test failed"); }
+int main() {
+  char temp[] = "/tmp/hss-led-protocol-XXXXXX";
+  const char* dir = mkdtemp(temp);
+  if (!dir) return 1;
+  std::string path = std::string(dir) + "/control";
+  int listener = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+  if (listener < 0 && errno == EPERM) {
+    std::cerr << "SKIP: execution environment prohibits Unix sockets\n";
+    rmdir(dir);
+    return 77;
+  }
+  sockaddr_un addr = {}; addr.sun_family = AF_UNIX;
+  std::memcpy(addr.sun_path, path.c_str(), path.size()+1);
+  require(listener >= 0 && !bind(listener, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) && !listen(listener, 4));
+  std::vector<std::string> received;
+  std::thread server([&]() {
+    for (unsigned i = 0; i < 4; ++i) {
+      pollfd event = {listener, POLLIN, 0};
+      if (poll(&event, 1, 2000) <= 0) return;
+      int fd = accept(listener, nullptr, nullptr);
+      if (fd < 0) return;
+      char buf[256];
+      ssize_t n = recv(fd, buf, sizeof(buf), 0);
+      if (n > 0) received.emplace_back(buf, n);
+      const char response[] = "OK accepted";
+      const ssize_t sent = send(fd, response, sizeof(response)-1, MSG_NOSIGNAL);
+      (void)sent;
+      close(fd);
+    }
+  });
+  RgbLed client(path);
+  client.set(4, 0, 0);
+  client.set(4, 1, 499);
+  client.set(4, 1, 499); // unchanged statuses must also reach a restarted daemon
+  client.set(5, 0, 100);
+  server.join();
+  require(received == std::vector<std::string>({"1 report 4 4 0 0", "1 report 4 1 499 499",
+                                               "1 report 4 1 499 499", "1 report 5 0 100 100"}));
+  close(listener); unlink(path.c_str()); rmdir(dir);
+  // A missing service must not create sysfs files or block indefinitely.
+  client.set(4, 0, 0);
+  std::cout << "LED client protocol: PASS\n";
+}
