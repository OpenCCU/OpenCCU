+    bool console = false;
+    int level = static_cast<int>(Logger::LOG_INFO);
+    for (int i = 1; i < argc; ++i) {
+      std::string arg(argv[i]);
+      if (arg == "--help" || arg == "-h") { LedCli::daemonHelp(std::cout); return 0; }
+      if (arg == "--version" || arg == "-V") { LedCli::version(std::cout, "hss_led"); return 0; }
