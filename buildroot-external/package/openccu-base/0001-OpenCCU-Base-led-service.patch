+      unsigned first = 0, second = 0, period = 0;
+      const led::LedState states[] = {newStateRed, newStateGreen, newStateBlue};
+      const int starts[] = {newStateRedStart, newStateGreenStart, newStateBlueStart};
+      for(unsigned i = 0; i < 3; ++i)
