#!/bin/sh
# shellcheck source=/dev/null
# shellcheck shell=dash disable=SC2169,SC3010
#
# Starts eq3configd.
#

OPENCCU_BASE_SERVICE_USERS=yes
OPENCCU_BASE_CONFIG_INIT=yes
[ ! -r /etc/default/openccu-base ] || . /etc/default/openccu-base

DAEMON="eq3configd"
PIDFILE="/var/run/${DAEMON}.pid"

init () {

	# we output the BidCos-Address and the
	# SerialNumber to /var/ids
	echo "BidCoS-Address=$(cat /var/rf_address)" >/var/ids
	echo "SerialNumber=$(cat /var/board_serial)" >>/var/ids

	# Recovery mounts the existing user configuration read-only.
	# Do not create files or change persistent ownership/permissions.
	[ "$OPENCCU_BASE_CONFIG_INIT" = yes ] || return 0

	# in case we have a BidCos-RF device (no empty /var/rf_address)
	# and there is no already existing /etc/config/ids we have to
	# copy it over
	if [[ -s /var/rf_address ]] && [[ ! -e /etc/config/ids ]] ; then
		cp /var/ids /etc/config/
	fi

	# make sure crypttool.cfg exists and has secure permissions
	if [[ ! -e /etc/config/crypttool.cfg ]] ; then
		touch /etc/config/crypttool.cfg
	fi
	chmod 0640 /etc/config/crypttool.cfg
	if [ "$OPENCCU_BASE_SERVICE_USERS" = yes ]; then
		chgrp eq3cfg /etc/config/crypttool.cfg
	fi
}

start() {
	echo -n "Starting ${DAEMON}: "
	init

	run_user=root
	if [ "$OPENCCU_BASE_SERVICE_USERS" = yes ]; then
		run_user=eq3cfg:eq3cfg
	fi
	if [ "$OPENCCU_BASE_CONFIG_INIT" = yes ]; then
		# The daemon inherits this preference from start-stop-daemon.
		echo -900 >/proc/$$/oom_score_adj 2> /dev/null
	fi

	start-stop-daemon -d / -S -q -b -m -c "$run_user" -p ${PIDFILE} --exec /bin/${DAEMON}
	echo "OK"
}
stop() {
	echo -n "Stopping ${DAEMON}: "
	start-stop-daemon -K -q -p ${PIDFILE}
	rm -f ${PIDFILE}
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
	start)
		start
	;;
	stop)
		stop
	;;
	restart|reload)
		restart
	;;
	*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
