# xe-guest-utilities: the XenServer guest agent (the systemd counterpart of
# S11xe-daemon). Only on Xen: the condition keeps it inactive on every other
# hypervisor and on bare metal.
[Unit]
Description=XenServer guest agent (xe-daemon)
ConditionPathExists=/proc/xen
After=proc-xen.mount network.target
Wants=proc-xen.mount

[Service]
Type=simple
# as in S11xe-daemon, the agent also starts when the distribution
# detection fails; it then reports its other metrics without it
ExecStartPre=-/usr/sbin/xe-linux-distribution /var/cache/xe-linux-distribution
ExecStart=/usr/sbin/xe-daemon -p /run/xe-daemon.pid
# xe-daemon exits with status 0 on a XenStore error (v8.4.0), so restart it
# whenever it exits
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
