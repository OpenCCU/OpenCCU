From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Maus <mail@jens-maus.de>
Date: Thu, 1 Oct 2026 18:53:23 +0000
Subject: [PATCH] kernel/Makefile: support direct kbuild/cross builds and
 module selection

Building the kernel modules directly via kbuild (make -C <kernel-dir>
M=<kernel>) as done by cross-compiling build systems like Buildroot
failed, because the Makefile unconditionally included
/lib/modules/$(uname -r)/build/scripts/Kbuild.include, which does not
exist on a build host. The kbuild specific part is now only evaluated
when called by kbuild (KBUILD_EXTMOD set) where the compiler helper
macros are already available, while the 'all'/'clean' wrapper targets
(used by DKMS) keep their previous behaviour.

In addition, build systems which only require a subset of the modules
can now set PIVCCU_MODULES to the list of modules to build and
PIVCCU_SOC_UART_AUTO=y to only build the SoC specific raw uart drivers
(pl011/dw_apb/meson) if the target kernel supports the respective SoC.
By default all modules are still built as expected by the DKMS package.

This allows OpenCCU to drop its local kernel/Makefile patch.

Upstream: https://github.com/OpenCCU/piVCCU/pull/1

Signed-off-by: Jens Maus <mail@jens-maus.de>
---
 kernel/Makefile | 39 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 5 deletions(-)

diff --git a/kernel/Makefile b/kernel/Makefile
index 6bcb524..002c873 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -13,22 +13,51 @@ obj-m += hb_rf_usb_2.o
 obj-m += hb_rf_eth.o
 obj-m += rtc-rx8130.o
 
-ifeq ($(KERNELRELEASE),)
-  KERNELRELEASE := $(shell uname -r)
+# By default all modules are built (the DKMS package expects a module for
+# every *.c file). Build systems which only need a subset of the modules
+# (e.g. OpenCCU/Buildroot) can set PIVCCU_MODULES to the list of module
+# names to build, e.g. PIVCCU_MODULES="generic_raw_uart hb_rf_usb".
+ifneq ($(PIVCCU_MODULES),)
+  obj-m := $(filter $(addsuffix .o,$(PIVCCU_MODULES)),$(obj-m))
 endif
 
-ifeq ($(KERNEL_DIR),)
-  KERNEL_DIR := /lib/modules/$(KERNELRELEASE)/build
+# If PIVCCU_SOC_UART_AUTO=y is set, the SoC specific raw uart drivers are
+# only built if the target kernel supports the respective SoC.
+ifeq ($(PIVCCU_SOC_UART_AUTO),y)
+  ifneq ($(CONFIG_ARCH_BCM2835),y)
+    obj-m := $(filter-out pl011_raw_uart.o,$(obj-m))
+  endif
+  ifneq ($(CONFIG_ARCH_ROCKCHIP),y)
+    obj-m := $(filter-out dw_apb_raw_uart.o,$(obj-m))
+  endif
+  ifneq ($(CONFIG_ARCH_MESON),y)
+    obj-m := $(filter-out meson_raw_uart.o,$(obj-m))
+  endif
 endif
 
-include $(KERNEL_DIR)/scripts/Kbuild.include
+ifneq ($(KBUILD_EXTMOD),)
+# Invoked by kbuild (make -C <kernel-dir> M=<this-dir>), either via the
+# 'all' target below or directly by a (cross-compiling) build system like
+# Buildroot. Kbuild already provides the compiler helper macros here and
+# the kernel sources are not necessarily located below /lib/modules.
 ifeq ($(call cc-option-yn,-mstack-protector-guard=sysreg -mstack-protector-guard-reg=sp_el0 -mstack-protector-guard-offset=0),n)
         KBUILD_CFLAGS += -DPIVCCU_CC_HAS_NO_STACKPROTECTOR_SYSREG
 endif
 
+else
+
+ifeq ($(KERNELRELEASE),)
+  KERNELRELEASE := $(shell uname -r)
+endif
+
+ifeq ($(KERNEL_DIR),)
+  KERNEL_DIR := /lib/modules/$(KERNELRELEASE)/build
+endif
+
 all:
 	$(MAKE) -C $(KERNEL_DIR) M=$(PWD) modules
 
 clean:
 	$(MAKE) -C $(KERNEL_DIR) M=$(PWD) clean
 
+endif
