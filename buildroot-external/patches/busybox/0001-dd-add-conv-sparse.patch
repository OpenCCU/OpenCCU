 	static const char iflag_words[] ALIGN1 =
 		"skip_bytes\0""count_bytes\0""fullblock\0""direct\0";
 	static const char oflag_words[] ALIGN1 =
@@ -348,6 +374,7 @@ int dd_main(int argc UNUSED_PARAM, char **argv)
 		OP_conv_noerror,
 		OP_conv_fsync,
 		OP_conv_swab,
+		OP_conv_sparse,
 	/* Unimplemented conv=XXX: */
 	//nocreat       do not create the output file
 	//excl          fail if the output file already exists
@@ -564,6 +591,22 @@ int dd_main(int argc UNUSED_PARAM, char **argv)
 		if (lseek(ofd, seek * blocksz, SEEK_CUR) < 0)
 			goto die_outfile;
 	}
+#if ENABLE_FEATURE_DD_IBS_OBS
+	if (G.flags & FLAG_SPARSE) {
+		struct stat st;
+
+		/* Holes only in regular files: on a block device a skipped
+		 * block would keep its old content, and with O_APPEND (also
+		 * when inherited, e.g. ">>" for stdout) every write goes to
+		 * the end, so the skipped bytes would be lost. */
+		if ((fcntl(ofd, F_GETFL) & O_APPEND)
+		 || fstat(ofd, &st) < 0
+		 || !S_ISREG(st.st_mode)
+		) {
+			G.flags &= ~FLAG_SPARSE;
+		}
+	}
+#endif
 
 	while (1) {
 		ssize_t n = ibs;
@@ -645,17 +688,27 @@ int dd_main(int argc UNUSED_PARAM, char **argv)
 		}
 	}
 
-	if (G.flags & FLAG_FSYNC) {
-		if (fsync(ofd) < 0)
-			goto die_outfile;
-	}
-
 #if ENABLE_FEATURE_DD_IBS_OBS
