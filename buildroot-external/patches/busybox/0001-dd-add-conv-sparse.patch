 static void dd_output_status(int UNUSED_PARAM cur_signal)
@@ -235,19 +241,39 @@ static ssize_t dd_read(void *ibuf, size_t ibs)
 	return n;
 }
 
+#if ENABLE_FEATURE_DD_IBS_OBS
+static bool is_nul_block(const char *buf, size_t len)
+{
+	/* buf[0] is NUL and every byte equals its predecessor */
+	return len != 0 && buf[0] == '\0' && memcmp(buf, buf + 1, len - 1) == 0;
+}
+#endif
+
 static bool write_and_stats(const void *buf, size_t len, size_t obs,
 	const char *filename)
 {
 	ssize_t n;
 
+#if ENABLE_FEATURE_DD_IBS_OBS
+	/* conv=sparse: seek over a block of NULs instead of writing it */
+	if ((G.flags & FLAG_SPARSE) && is_nul_block(buf, len)
+	 && lseek(ofd, len, SEEK_CUR) >= 0
+	) {
+		G.sparse_hole_at_end = 1;
+		n = len;
+	} else
+#endif
+	{
  IF_FEATURE_DD_IBS_OBS(write_again:)
-	n = full_write(ofd, buf, len);
+		n = full_write(ofd, buf, len);
 #if ENABLE_FEATURE_DD_IBS_OBS
 # ifdef O_DIRECT
-	if (n < 0 && (G.flags & FLAG_ODIRECT) && clear_O_DIRECT(ofd))
-		goto write_again;
+		if (n < 0 && (G.flags & FLAG_ODIRECT) && clear_O_DIRECT(ofd))
+			goto write_again;
 # endif
+		G.sparse_hole_at_end = 0;
 #endif
+	}
 
 #if ENABLE_FEATURE_DD_THIRD_STATUS_LINE
 	if (n > 0)
@@ -318,7 +344,7 @@ int dd_main(int argc UNUSED_PARAM, char **argv)
